# Copy to .env.local for local development. Never commit .env.local.
APP_ENV=local
# Optional hosted teacher preview: student account only, password at least 12 characters.
ENABLE_DEMO_LOGIN=false
DEMO_LOGIN_PASSWORD=
# Real Turnstile widget keys for production; secret is server-only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
SESSION_SECRET=replace-with-at-least-32-random-bytes
UNIVERSITY_OIDC_ISSUER=
UNIVERSITY_OIDC_CLIENT_ID=
UNIVERSITY_OIDC_CLIENT_SECRET=
UNIVERSITY_EMAIL_DOMAIN=university.edu
UNSTOP_API_KEY=
DEVFOLIO_API_KEY=
